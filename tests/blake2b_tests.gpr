with "config/blake2b_tests_config.gpr";
with "blake2b.gpr";

project Blake2b_Tests is

   --  Ada test harness plus two vendored C implementations of BLAKE2b
   --  (ref/: the BLAKE2 reference code and Monocypher) used as oracles.
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "ref/", "config/");
   for Create_Missing_Dirs use "True";

   --  One object and executable directory per build-matrix cell, so the
   --  cells built by scripts/matrix.sh never overwrite each other.
   Cell := external ("BLAKE2B_OPT", "profile") & "-"
           & external ("BLAKE2B_CHECKS", "profile");

   for Object_Dir use
     "obj/" & Blake2b_Tests_Config.Build_Profile & "-" & Cell;
   for Exec_Dir use "bin/" & Cell;
   for Main use ("test_main.adb", "bench_main.adb");

   package Compiler is
      --  The harness always checks its own assertions: they are how it
      --  evaluates the ghost specification.
      for Default_Switches ("Ada") use
        Blake2b_Tests_Config.Ada_Compiler_Switches & ("-gnata");
      --  Except the window onto the counter's private unit: its Add_Counter
      --  is Inline_Always, so with -gnata its contract, written with the
      --  ghost big integers that the library's profiles do not compile,
      --  would be expanded here and fail to link. The suite checks the same
      --  property against Ada's big integers itself.
      for Switches ("blake2b-hashing-counter_testing.adb") use
        Blake2b_Tests_Config.Ada_Compiler_Switches;
      --  The oracles are third-party code, compiled as published, at the
      --  library's release optimisation level so that the benchmark
      --  compares like with like (same compiler, same -O3, no -march).
      for Default_Switches ("C") use ("-O3", "-std=c11");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Blake2b_Tests;
